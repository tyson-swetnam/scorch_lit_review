# SCORCH Literature Review - Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your actual API key below
# 3. NEVER commit .env to git (already in .gitignore)
#
# Get your API key from: https://console.anthropic.com/

# Anthropic Claude API Key (required for batch_process_pdfs.py, synthesize.py,
# ask_papers.py, query_literature.py). Not needed for convert_to_duckdb.py or
# build_okf.py.
ANTHROPIC_API_KEY=your-api-key-here

# --- Optional: per-stage model overrides (defaults shown) ---
# SCORCH_SCREEN_MODEL=claude-haiku-4-5
# SCORCH_EXTRACT_MODEL=claude-sonnet-4-6
# SCORCH_VERIFY_MODEL=claude-opus-4-8
# SCORCH_SYNTHESIS_MODEL=claude-opus-4-8

# --- Optional: batch tuning ---
# SCORCH_BATCH_CONCURRENCY=4      # parallel PDFs in the local async runner
# SCORCH_EXTRACT_MAX_TOKENS=16000 # max output tokens per extraction

# --- Optional: relocate the repo root (paths derive from it) ---
# SCORCH_BASE_DIR=/path/to/scorch_lit_review
